diff --git a/crates/ui-egui/src/embed.rs b/crates/ui-egui/src/embed.rs
new file mode 100644
index 00000000..3f8c228c
--- /dev/null
+++ b/crates/ui-egui/src/embed.rs
@@ -0,0 +1,137 @@
+//! Embedding hooks: what a page that hosts WordCraft (a web app embedding the editor as a
+//! component) may turn off, take over or listen to. None of it is saved with the preferences:
+//! the host sets it at every start, and a stand-alone WordCraft never changes it.
+
+use serde::{Deserialize, Serialize};
+
+/// Someone else editing the document at the same time (shown in the title bar, as Word does).
+#[derive(Clone, Debug, PartialEq)]
+pub struct Collaborator {
+    pub name: String,
+    pub color: [u8; 3],
+}
+
+/// One File menu item as the host arranged it (`ui.backstage` pages and export formats).
+#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]
+#[serde(default, rename_all = "camelCase")]
+pub struct FileMenuItem {
+    /// A File page (`print`, `share`...), an export format (`export.pdf`) or the host's own id.
+    pub id: String,
+    /// Shown instead of WordCraft's label when not empty.
+    pub label: String,
+    pub hidden: bool,
+    /// Why it is off (shown on hover); empty when it is on.
+    pub disabled: String,
+    /// Clicking it asks the host (`file:<id>` in [`Embed::host_events`]).
+    pub host: bool,
+    /// A heading it sits under; items with the same section sit together.
+    pub section: String,
+}
+
+impl FileMenuItem {
+    /// The host's settings for `id`, if it gave any.
+    pub fn find<'a>(items: &'a [FileMenuItem], id: &str) -> Option<&'a FileMenuItem> {
+        items.iter().find(|i| i.id == id)
+    }
+}
+
+/// The host's switches. Serialized in camelCase so a page can set them as JSON.
+#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]
+#[serde(default, rename_all = "camelCase")]
+pub struct Embed {
+    /// No title bar (AutoSave, Quick Access Toolbar, title, search, account).
+    pub hide_title_bar: bool,
+    /// No ribbon, tab row included (Word's "Auto-hide Ribbon").
+    pub hide_ribbon: bool,
+    /// No status bar.
+    pub hide_status_bar: bool,
+    /// Ribbon tabs the host doesn't offer (`File`, `Home`, `Insert`, `Draw`...).
+    pub hidden_tabs: Vec<String>,
+    /// The host keeps documents: saves go to it ([`craft::host::Files::save`]) and AutoSave may
+    /// run, writing through it, although the page can't write to the user's files.
+    pub host_saves: bool,
+    /// An AI button beside Comments; a click queues `ai`.
+    pub ai_button: bool,
+    /// The host keeps version history: the title and File › Info queue `versions`.
+    pub host_versions: bool,
+    /// The host owns comments: New Comment queues `compose` (no empty comment is made) and the
+    /// comments pane never opens (`comments`, and `comment:<id>` for a balloon click).
+    pub host_comments: bool,
+    /// Share queues `share` instead of WordCraft's own dialog.
+    pub host_share: bool,
+    pub hide_context_menu: bool,
+    pub hide_rulers: bool,
+    pub hide_nav_pane: bool,
+    /// No collaborator avatars in the title bar.
+    pub hide_presence: bool,
+    pub hide_share: bool,
+    /// No Editing / Reviewing / Viewing switch.
+    pub hide_mode_switch: bool,
+    /// No Comments button in the ribbon's corner.
+    pub hide_comments_button: bool,
+    pub hide_zoom: bool,
+    /// No page-view buttons in the status bar.
+    pub hide_view_switcher: bool,
+    /// The File menu, arranged by the host; empty is WordCraft's own.
+    pub file_menu: Vec<FileMenuItem>,
+    /// Font families the host can fetch on demand (web fonts), listed in the font box.
+    pub cloud_fonts: Vec<String>,
+
+    /// Events for the host, taken by it after each frame: `ai`, `versions`, `compose`,
+    /// `comments`, `comment:<id>`, `share`, `file:<id>`.
+    #[serde(skip)]
+    pub host_events: Vec<String>,
+    /// Other people editing now (real-time co-editing), shown beside the account avatar.
+    #[serde(skip)]
+    pub collaborators: Vec<Collaborator>,
+    /// Families picked that aren't installed: the host fetches them, adds them with
+    /// `FontDb::add_font`, then calls [`crate::WordApp::fonts_changed`].
+    #[serde(skip)]
+    pub font_requests: Vec<String>,
+    /// Families whose font-box row is on screen but not loaded: the regular face is enough.
+    #[serde(skip)]
+    pub font_previews: Vec<String>,
+}
+
+impl Embed {
+    /// Whether the host offers ribbon tab `tab`.
+    pub fn tab_shown(&self, tab: &str) -> bool {
+        !self.hidden_tabs.iter().any(|t| t.eq_ignore_ascii_case(tab))
+    }
+
+    /// Queue an event for the host, once per frame at most.
+    pub fn event(&mut self, event: impl Into<String>) {
+        let event = event.into();
+        if !self.host_events.contains(&event) {
+            self.host_events.push(event);
+        }
+    }
+
+    /// Replace the switches with `next`, keeping what the host hasn't taken yet.
+    pub fn apply(&mut self, next: Embed) {
+        let events = std::mem::take(&mut self.host_events);
+        let collaborators = std::mem::take(&mut self.collaborators);
+        let requests = std::mem::take(&mut self.font_requests);
+        let previews = std::mem::take(&mut self.font_previews);
+        *self = Embed { host_events: events, collaborators, font_requests: requests, font_previews: previews, ..next };
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn switches_read_from_camel_case_and_keep_pending_events() {
+        let mut e = Embed::default();
+        e.event("ai");
+        e.event("ai");
+        assert_eq!(e.host_events, ["ai"]);
+        let next: Embed = serde_json::from_value(serde_json::json!({"hideRibbon": true, "hiddenTabs": ["draw"], "fileMenu": [{"id": "print", "disabled": "Off"}]})).unwrap();
+        e.apply(next);
+        assert!(e.hide_ribbon && !e.hide_title_bar);
+        assert!(!e.tab_shown("Draw") && e.tab_shown("Home"));
+        assert_eq!(FileMenuItem::find(&e.file_menu, "print").map(|i| i.disabled.as_str()), Some("Off"));
+        assert_eq!(e.host_events, ["ai"], "a pending event survives new switches");
+    }
+}
