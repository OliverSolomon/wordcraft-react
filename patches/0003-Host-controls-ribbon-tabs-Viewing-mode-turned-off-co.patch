+    /// Fonts were added at run time ([`Self::font_requests`]): list them and lay the document out
+    /// again with them.
+    pub fn fonts_changed(&mut self) {
+        self.previews.invalidate_families();
+        self.session.relayout();
+    }
+
+    /// The font box picked `family`: remember it (Word's "Recently Used Fonts", ten at most) and
+    /// ask the host for it if it isn't installed.
+    pub fn font_picked(&mut self, family: &str) {
+        self.ui.recent_fonts.retain(|f| f != family);
+        self.ui.recent_fonts.insert(0, family.to_string());
+        self.ui.recent_fonts.truncate(10);
+        if !wordcraft_fonts::FontDb::global().has_family(family)
+            && self.cloud_fonts.iter().any(|f| f == family)
+            && !self.font_requests.iter().any(|f| f == family)
+        {
+            self.font_requests.push(family.to_string());
+        }
+    }
+
+    /// The font box's list: theme fonts, recently used, then all (installed and on demand), each
+    /// section under a heading, as in Word.
+    pub fn font_box_items(&mut self) -> Vec<String> {
+        use crate::widgets::SECTION;
+        let mut all = self.previews.families();
+        all.extend(self.cloud_fonts.iter().cloned());
+        all.sort_by_key(|a| a.to_lowercase());
+        all.dedup();
+        let mut out = vec![format!("{SECTION}{}", tl!("Theme Fonts"))];
+        out.push(wordcraft_doc::styles::HEADING_FONT.to_string());
+        out.push(wordcraft_doc::styles::BODY_FONT.to_string());
+        if !self.ui.recent_fonts.is_empty() {
+            out.push(format!("{SECTION}{}", tl!("Recently Used Fonts")));
+            out.extend(self.ui.recent_fonts.iter().cloned());
+        }
+        out.push(format!("{SECTION}{}", tl!("All Fonts")));
+        out.extend(all);
+        out
+    }
+
+    /// Whether the host offers ribbon tab `tab`.
+    pub fn tab_shown(&self, tab: &str) -> bool {
+        !self.ui.hidden_tabs.iter().any(|t| t.eq_ignore_ascii_case(tab))
+    }
