+    /// Why the host's settings refuse command `id` (Viewing mode, or a command it turned off), or
+    /// `None` when it may run. `mutates` is whether the command changes the document.
+    pub fn host_block(&self, id: &str, mutates: bool) -> Option<&'static str> {
+        let off = self.disabled_commands.iter().any(|d| match d.strip_suffix('*') {
+            Some(prefix) => id.starts_with(prefix),
+            None => d == id,
+        });
+        if off {
+            return Some("turned off in this app");
+        }
+        // Viewing: nothing that changes the document, apart from opening, saving and exporting.
+        if self.viewing && mutates && !id.starts_with("file.") && !id.starts_with("view.") {
+            return Some("you're viewing; switch to Editing to make changes");
+        }
+        None
+    }
+
     /// Why command `id` can't run now, for greying it out: its own `enabled` check, then what
     /// Restrict Editing refuses outright. `None` when it can run (or doesn't exist).
     pub fn why_disabled(&self, id: &str) -> Option<&'static str> {
         let spec = self.registry.get(id)?;
         (spec.enabled)(self)
+            .or_else(|| self.host_block(id, spec.mutates))
             .or_else(|| crate::cmd::md_source::refusal(self, id, spec.mutates))
             .or_else(|| if spec.mutates { crate::cmd::protect::greyed_out(self, id, || self.protect_facts()) } else { None })
     }
