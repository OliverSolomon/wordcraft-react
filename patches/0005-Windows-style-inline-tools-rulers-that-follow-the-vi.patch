+/// Above a context menu opened at `at` (its top-left corner), left-aligned with it, clamped
+/// inside the viewport.
+pub fn menu_rect(at: egui::Pos2, viewport: Rect) -> Option<Rect> {
+    if !at.x.is_finite() || !at.y.is_finite() || !viewport.is_finite() || !viewport.is_positive() {
+        return None;
+    }
+    let x = at.x.clamp(viewport.left(), (viewport.right() - BAR_W).max(viewport.left()));
+    let y = (at.y - VGAP - BAR_H).max(viewport.top());
+    Some(Rect::from_min_size(pos2(x, y), Vec2::new(BAR_W, BAR_H)))
+}
