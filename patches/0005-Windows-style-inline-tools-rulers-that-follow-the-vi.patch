+/// The page the rulers measure: the caret's page while it fills a good part of the view, otherwise
+/// the page that fills most of it (scrolling away from the caret used to leave the vertical ruler
+/// blank or measuring a page that had scrolled off).
+fn ruler_page(caret_page: usize, rects: &[Rect], view: egui::Rangef) -> usize {
+    let shown = |r: &Rect| (r.max.y.min(view.max) - r.min.y.max(view.min)).max(0.0);
+    if rects.get(caret_page).is_some_and(|r| shown(r) >= view.span() * 0.4) {
+        return caret_page;
+    }
+    rects.iter().enumerate().max_by(|a, b| shown(a.1).total_cmp(&shown(b.1))).map_or(caret_page, |(i, _)| i)
+}
