     pub fn run(&mut self, id: &str, params: Value) -> Result<Value, String> {
+        if let Some(r) = self.host_takes(id, &params) {
+            return r;
+        }
         // Undo and Redo act on whole steps: a SmartArt typing run still open is folded into its one step first,
