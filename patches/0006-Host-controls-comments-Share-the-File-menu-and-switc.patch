+/// One side-menu row: WordCraft's page, or an item a host page arranged ([`crate::embed::FileMenuItem`]).
+struct NavItem {
+    id: String,
+    name: Label,
+    icon: Option<&'static str>,
+    /// Why it is greyed out, shown on hover; empty when it is on.
+    disabled: String,
+    /// The host page answers it (its own item, or one it takes over).
+    host: bool,
+    /// The heading it sits under (shown when it differs from the row above's).
+    section: String,
+}
+
+/// The side menu's rows: WordCraft's pages, or the host page's arrangement of them and its own
+/// items, in its order (export formats are arranged on the Export page instead).
+fn nav_items(app: &WordApp) -> Vec<NavItem> {
+    let own = |id: &str| PAGES.iter().find(|(p, ..)| *p == id);
+    let menu = &app.embed.file_menu;
+    if menu.is_empty() {
+        return PAGES
+            .iter()
+            .map(|(id, name, icon)| NavItem { id: (*id).into(), name: label(name), icon: Some(icon), disabled: String::new(), host: false, section: String::new() })
+            .collect();
+    }
+    menu.iter()
+        .filter(|i| !i.hidden && !i.id.starts_with("export."))
+        .map(|i| {
+            let page = own(&i.id);
+            let name = if !i.label.is_empty() {
+                Label::from(i.label.clone())
+            } else if let Some((_, name, _)) = page {
+                label(name)
+            } else if i.id == "share" {
+                label("Share")
+            } else {
+                Label::from(i.id.clone())
+            };
+            let icon = page.map(|(_, _, icon)| *icon).or_else(|| (i.id == "share").then_some("share"));
+            let host = i.host || (page.is_none() && i.id != "share");
+            NavItem { id: i.id.clone(), name, icon, disabled: i.disabled.clone(), host, section: i.section.clone() }
+        })
+        .collect()
+}
+
+/// The side menu's page rows, one full-width button per page, under the host's section headings.
