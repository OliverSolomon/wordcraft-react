+    /// What a host page owns instead of WordCraft ([`crate::embed::Embed`]): with comments its
+    /// own, New Comment without text asks it to compose one (no empty comment is made) and the
+    /// comments pane asks it to show its own; with sharing its own, Share asks it. `None` for
+    /// everything else.
+    fn host_takes(&mut self, id: &str, params: &Value) -> Option<Result<Value, String>> {
+        if self.embed.host_comments {
+            if id == "review.newComment" && params.get("text").and_then(Value::as_str).is_none_or(|t| t.trim().is_empty()) {
+                if let Some(why) = self.session.why_disabled(id) {
+                    return Some(Err(format!("{id}: {why}")));
+                }
+                self.embed.event("compose");
+                return Some(Ok(json!({"pending": "compose"})));
+            }
+            if id == "view.commentsPane" {
+                self.session.view.comments_pane = false;
+                self.embed.event("comments");
+                return Some(Ok(json!({"pending": "comments"})));
+            }
+        }
+        if self.embed.host_share && id == "file.share" {
+            self.embed.event("share");
+            return Some(Ok(json!({"pending": "share"})));
+        }
+        None
+    }
+
