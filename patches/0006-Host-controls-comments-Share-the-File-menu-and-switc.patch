+            let _ = Text::new(item.section.clone()).role(TypeRole::Caption).show(ui);
+        }
+        section = &item.section;
         // No document open (#1129): Info, Save, Save As, Print and Export are greyed out.
-        let on = has_document || works_without_document(id);
-        let row = Button::new(label(name))
-            .id_salt(("backstage-page", id))
-            .icon(crate::icons::spec(icon))
+        let on = (has_document || works_without_document(&item.id) || item.host) && item.disabled.is_empty();
+        let mut row = Button::new(item.name.clone())
+            .id_salt(("backstage-page", item.id.as_str()))
             .variant(Variant::GHOST)
             .sizing(Sizing::FillWidth)
             // Icon and name at the reading start of the full-width row, as production's menu.
             .align(HAlign::Start)
-            .selected(current == id)
-            .enabled(on)
-            .show(ui);
+            .selected(current == item.id)
+            .enabled(on);
+        if let Some(icon) = item.icon {
+            row = row.icon(crate::icons::spec(icon));
+        }
+        if !item.disabled.is_empty() {
+            row = row.tooltip(item.disabled.clone());
+        }
+        let row = row.show(ui);
         if clicked(&row) {
-            *choice.page.borrow_mut() = Some(id);
+            if item.host {
+                *choice.host.borrow_mut() = Some(item.id.clone());
+            } else {
+                *choice.page.borrow_mut() = Some(item.id.clone());
+            }
         }
     }
 }
