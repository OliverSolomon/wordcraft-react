+/// One File menu item as the host arranges it (see [`UiState::file_menu`]).
+#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]
+#[serde(default, rename_all = "camelCase")]
+pub struct FileMenuItem {
+    /// `new`, `open`, `info`, `save`, `saveAs`, `print`, `share`, `export`, `close`, `options`,
+    /// `export.pdf`, `export.docx`…, or the host's own.
+    pub id: String,
+    /// Shown instead of WordCraft's name; empty keeps it.
+    pub label: String,
+    pub hidden: bool,
+    /// Greyed out with this reason as its tooltip; empty: enabled.
+    pub disabled: String,
+    /// Clicking asks the host (`file:<id>`) instead of doing WordCraft's action.
+    pub host: bool,
+    /// A heading shown above this item when it differs from the previous item's.
+    pub section: String,
+}
+
+impl FileMenuItem {
+    /// The host's entry for `id`, if it arranged the menu.
+    pub fn find<'a>(items: &'a [FileMenuItem], id: &str) -> Option<&'a FileMenuItem> {
+        items.iter().find(|i| i.id == id)
+    }
+}
+
