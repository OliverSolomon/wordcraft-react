+#[cfg(test)]
+mod host_menu_tests {
+    use egui::accesskit::Role;
+    use egui_kittest::kittest::{NodeT as _, Queryable};
+    use serde_json::json;
+
+    use crate::{FileMenuItem, Services, WordApp};
+
+    fn harness(a: WordApp) -> egui_kittest::Harness<'static, WordApp> {
+        egui_kittest::Harness::builder().with_size(egui::vec2(1440.0, 900.0)).build_ui_state(
+            |ui, app: &mut WordApp| {
+                let ctx = ui.ctx().clone();
+                app.logic(&ctx);
+                app.ui(ui);
+            },
+            a,
+        )
+    }
+
+    fn item(id: &str) -> FileMenuItem {
+        FileMenuItem { id: id.into(), ..Default::default() }
+    }
+
+    #[test]
+    fn the_host_arranges_the_file_menu() {
+        let mut a = WordApp::new(wordcraft_engine::Session::new(wordcraft_doc::Document::from_text("x")), Services::default());
+        a.ui.file_menu = vec![
+            FileMenuItem { label: "Download a copy".into(), ..item("export") },
+            FileMenuItem { section: "Organise".into(), ..item("moveToFolder") },
+            FileMenuItem { label: "Move to folder".into(), section: "Organise".into(), ..item("moveToFolder2") },
+            FileMenuItem { disabled: "Printing is off for this document".into(), ..item("print") },
+            FileMenuItem { hidden: true, ..item("open") },
+            item("share"),
+            FileMenuItem { hidden: true, ..item("export.docx") },
+            FileMenuItem { label: "PDF for the board".into(), ..item("export.pdf") },
+        ];
+        a.run("ui.backstage", json!({"value": true, "page": "export"})).unwrap();
+        let mut h = harness(a);
+        h.run_steps(4);
+        assert!(h.query_by_label("Download a copy").is_some(), "renamed");
+        assert!(h.query_by_label("Open").is_none(), "hidden");
+        assert!(h.query_by_label("Share").is_some(), "Share is a File item");
+        assert!(h.query_by_label("Organise").is_some(), "a section heading");
+        assert!(h.query_by_label("PDF for the board").is_some(), "an export format renamed");
+        assert!(h.query_by_label("Word document (*.docx)").is_none(), "an export format hidden");
+        h.get_by_role_and_label(Role::Button, "Move to folder").click();
+        h.run_steps(2);
+        assert!(h.state().host_events.iter().any(|e| e == "file:moveToFolder2"), "the host's own item asks the host: {:?}", h.state().host_events);
+        assert!(h.get_by_label("Print").accesskit_node().is_disabled(), "disabled with a reason");
+    }
+
+    #[test]
+    fn host_comments_never_make_an_empty_comment_or_open_the_pane() {
+        let mut a = WordApp::new(wordcraft_engine::Session::new(wordcraft_doc::Document::from_text("Hello world")), Services::default());
+        a.ui.host_comments = true;
+        a.run("select.all", json!({})).unwrap();
+        // Ribbon, mini toolbar, context menu and Ctrl+Alt+M all run this.
+        a.run("review.newComment", json!({})).unwrap();
+        assert!(a.session.doc.comments.is_empty(), "no empty comment");
+        assert_eq!(a.host_events, vec!["compose".to_string()]);
+        a.run("view.commentsPane", json!({"value": true})).unwrap();
+        assert!(!a.session.view.comments_pane, "the pane stays shut");
+        // The host's own comment (with text) is made, and the pane still stays shut.
+        a.run("review.newComment", json!({"text": "Check this"})).unwrap();
+        assert_eq!(a.session.doc.comments.len(), 1);
+        let mut h = harness(a);
+        h.run_steps(2);
+        assert!(!h.state().session.view.comments_pane);
+    }
+}
