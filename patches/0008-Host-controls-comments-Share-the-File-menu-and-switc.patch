+/// The File menu's items: the host's arrangement (`file_menu`), shown items only, or WordCraft's.
+fn nav_items(app: &WordApp) -> Vec<crate::FileMenuItem> {
+    let own = || PAGES.iter().map(|(id, _)| crate::FileMenuItem { id: (*id).into(), ..Default::default() });
+    let items: Vec<crate::FileMenuItem> = if app.ui.file_menu.iter().any(|i| !i.id.starts_with("export.")) {
+        app.ui.file_menu.iter().filter(|i| !i.id.starts_with("export.")).cloned().collect()
+    } else {
+        // Only per-item settings for pages the host left in place.
+        own().map(|d| crate::FileMenuItem::find(&app.ui.file_menu, &d.id).cloned().unwrap_or(d)).collect()
+    };
+    items.into_iter().filter(|i| !i.hidden).collect()
+}
