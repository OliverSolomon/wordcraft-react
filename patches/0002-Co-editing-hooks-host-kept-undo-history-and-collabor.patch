From 74ad5624e0b4100fc95849b2ae71da507d8d855a Mon Sep 17 00:00:00 2001
From: ndamathia <47696354+OliverSolomon@users.noreply.github.com>
Date: Sat, 10 Oct 2026 19:48:53 +0300
Subject: [PATCH] Co-editing hooks: host-kept undo history and collaborators in
 the title bar

- Session::external_history lets a host that keeps its own history (real-time
  co-editing, where Undo takes back only this person's changes) take Undo and
  Redo: they queue in history_requests, and can_undo/can_redo report
  external_can, so the Quick Access Toolbar and Ctrl+Z keep working.
- WordApp::collaborators lists the other people editing; the title bar shows
  them beside the account avatar, as Word does.
---
 crates/engine/src/session.rs | 28 ++++++++++++++++++++++++++++
 crates/ui-egui/src/chrome.rs | 10 ++++++++++
 crates/ui-egui/src/lib.rs    | 10 ++++++++++
 3 files changed, 48 insertions(+)

diff --git a/crates/engine/src/session.rs b/crates/engine/src/session.rs
index f779da5..021c431 100644
--- a/crates/engine/src/session.rs
+++ b/crates/engine/src/session.rs
@@ -204,6 +204,13 @@ pub struct Session {
     pub read_aloud: crate::speech::ReadAloud,
     /// Preferences the front end saves between runs.
     pub prefs: Prefs,
+    /// A host that keeps its own edit history takes Undo and Redo (real-time co-editing, where
+    /// Undo must take back only this person's changes): `undo`/`redo` then queue a request in
+    /// `history_requests` (`false` = undo, `true` = redo) instead of restoring a snapshot, and
+    /// `can_undo`/`can_redo` report `external_can`.
+    pub external_history: bool,
+    pub history_requests: Vec<bool>,
+    pub external_can: (bool, bool),
     /// Editing inside an equation: which one and the caret in it.
     pub math: Option<MathEdit>,
     /// Equations are typed in LaTeX rather than the linear format.
@@ -282,6 +289,9 @@ impl Session {
             math_latex: false,
             math_normal_text: false,
             prefs: Prefs::default(),
+            external_history: false,
+            history_requests: Vec::new(),
+            external_can: (false, false),
             read_aloud: Default::default(),
         }
     }
@@ -367,9 +377,15 @@ impl Session {
         self.typing_open = false;
     }
     pub fn can_undo(&self) -> bool {
+        if self.external_history {
+            return self.external_can.0;
+        }
         !self.history.is_empty()
     }
     pub fn can_redo(&self) -> bool {
+        if self.external_history {
+            return self.external_can.1;
+        }
         !self.redo.is_empty()
     }
     pub fn undo_label(&self) -> Option<&str> {
@@ -387,6 +403,10 @@ impl Session {
     }
     pub fn undo(&mut self) -> bool {
         self.typing_open = false;
+        if self.external_history {
+            self.history_requests.push(false);
+            return self.external_can.0;
+        }
         let Some(u) = self.history.pop().map(Arc::unwrap_or_clone) else { return false };
         let cur = Undo { label: u.label.clone(), doc: std::mem::replace(&mut self.doc, u.doc), sel: std::mem::replace(&mut self.sel, u.sel) };
         self.redo.push(Arc::new(cur));
@@ -395,6 +415,10 @@ impl Session {
     }
     pub fn redo(&mut self) -> bool {
         self.typing_open = false;
+        if self.external_history {
+            self.history_requests.push(true);
+            return self.external_can.1;
+        }
         let Some(u) = self.redo.pop().map(Arc::unwrap_or_clone) else { return false };
         let cur = Undo { label: u.label.clone(), doc: std::mem::replace(&mut self.doc, u.doc), sel: std::mem::replace(&mut self.sel, u.sel) };
         self.history.push(Arc::new(cur));
@@ -477,6 +501,10 @@ impl Session {
             document_id: _,
             read_aloud: _,
             prefs: _,
+            // The host's history requests are not part of an edit.
+            external_history: _,
+            history_requests: _,
+            external_can: _,
             // Equation editing mode, like `view`: not part of the document or its history.
             math: _,
             math_latex: _,
diff --git a/crates/ui-egui/src/chrome.rs b/crates/ui-egui/src/chrome.rs
index 28f5344..c23ef7c 100644
--- a/crates/ui-egui/src/chrome.rs
+++ b/crates/ui-egui/src/chrome.rs
@@ -79,6 +79,16 @@ pub fn title_bar(app: &mut WordApp, ui: &mut Ui) {
                     let initials: String = app.session.author.split_whitespace().filter_map(|w| w.chars().next()).take(2).collect();
                     ui.painter().text(r.center(), Align2::CENTER_CENTER, initials, semibold(10.5), egui::Color32::WHITE);
                     resp.on_hover_text(format!("{} — set your name in File › Options", app.session.author));
+                    // People editing at the same time, as in Word's co-authoring.
+                    for c in app.collaborators.iter().take(6) {
+                        let (r, resp) = ui.allocate_exact_size(vec2(24.0, 26.0), Sense::hover());
+                        let fill = egui::Color32::from_rgb(c.color[0], c.color[1], c.color[2]);
+                        ui.painter().circle_filled(r.center(), 11.0, fill);
+                        ui.painter().circle_stroke(r.center(), 11.0, Stroke::new(1.5, t.title_bar));
+                        let initials: String = c.name.split_whitespace().filter_map(|w| w.chars().next()).take(2).collect();
+                        ui.painter().text(r.center(), Align2::CENTER_CENTER, initials, semibold(9.5), egui::Color32::WHITE);
+                        resp.on_hover_text(format!("{} is editing", c.name));
+                    }
                     ui.add_space(8.0);
                     if app.ui.show_discord {
                         let (r, resp) = ui.allocate_exact_size(vec2(84.0, 22.0), Sense::click());
diff --git a/crates/ui-egui/src/lib.rs b/crates/ui-egui/src/lib.rs
index 3b7bd91..3fad294 100644
--- a/crates/ui-egui/src/lib.rs
+++ b/crates/ui-egui/src/lib.rs
@@ -126,6 +126,13 @@ impl Default for UiState {
     }
 }
 
+/// Someone else editing the document at the same time (shown in the title bar, as Word does).
+#[derive(Clone, Debug, PartialEq)]
+pub struct Collaborator {
+    pub name: String,
+    pub color: [u8; 3],
+}
+
 /// The application.
 pub struct WordApp {
     pub session: Session,
@@ -156,6 +163,8 @@ pub struct WordApp {
     sent_title: String,
     pub quit_requested: bool,
     pub autosave: bool,
+    /// Other people editing now (real-time co-editing), shown beside the account avatar.
+    pub collaborators: Vec<Collaborator>,
     pub word_count: (u64, usize),
     last_autosave: f64,
     /// The tab shown before the Equation tab came up (restored when editing ends).
@@ -217,6 +226,7 @@ impl WordApp {
             sent_title: String::new(),
             quit_requested: false,
             autosave: true,
+            collaborators: Vec::new(),
             word_count: (0, 0),
             last_autosave: 0.0,
             equation_prev_tab: None,
-- 
