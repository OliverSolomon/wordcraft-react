From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Solomon <47696354+OliverSolomon@users.noreply.github.com>
Date: Fri, 27 Nov 2026 08:37:24 +0000
Subject: [PATCH 2/6] Co-editing hooks: host-kept undo history and
 collaborators in the title bar

---
 crates/engine/src/session.rs           |  7 +++++++
 crates/engine/src/session/documents.rs |  3 +++
 crates/engine/src/session/history.rs   | 14 ++++++++++++++
 crates/engine/src/session/lifecycle.rs |  3 +++
 crates/engine/src/session/snapshot.rs  |  4 ++++
 crates/ui-egui/src/chrome/title_bar.rs |  9 +++++++++
 6 files changed, 40 insertions(+)

diff --git a/crates/engine/src/session.rs b/crates/engine/src/session.rs
index e448d962..6345a442 100644
--- a/crates/engine/src/session.rs
+++ b/crates/engine/src/session.rs
@@ -226,6 +226,13 @@ pub struct Session {
     /// `None` is WordCraft's default, US English. The front end sets it from the interface
     /// language with [`Session::set_editing_language`] (a Polish interface writes Polish).
     pub editing_lang: Option<String>,
+    /// A host that keeps its own edit history takes Undo and Redo (real-time co-editing, where
+    /// Undo must take back only this person's changes): `undo`/`redo` then queue a request in
+    /// `history_requests` (`false` = undo, `true` = redo) instead of restoring a snapshot, and
+    /// `can_undo`/`can_redo` report `external_can`.
+    pub external_history: bool,
+    pub history_requests: Vec<bool>,
+    pub external_can: (bool, bool),
     /// Editing inside an equation: which one and the caret in it.
     pub math: Option<MathEdit>,
     /// Equations are typed in LaTeX rather than the linear format.
diff --git a/crates/engine/src/session/documents.rs b/crates/engine/src/session/documents.rs
index 40fdc8fd..6dae8161 100644
--- a/crates/engine/src/session/documents.rs
+++ b/crates/engine/src/session/documents.rs
@@ -280,6 +280,9 @@ impl Session {
             findings: _,
             ribbon: _,
             editing_lang: _,
+            external_history: _,
+            history_requests: _,
+            external_can: _,
             math_latex: _,
             math_normal_text: _,
             last_highlight: _,
diff --git a/crates/engine/src/session/history.rs b/crates/engine/src/session/history.rs
index e625acfb..8392a979 100644
--- a/crates/engine/src/session/history.rs
+++ b/crates/engine/src/session/history.rs
@@ -133,10 +133,16 @@ impl Session {
     }
 
     pub fn can_undo(&self) -> bool {
+        if self.external_history {
+            return self.external_can.0;
+        }
         !self.history.is_empty()
     }
 
     pub fn can_redo(&self) -> bool {
+        if self.external_history {
+            return self.external_can.1;
+        }
         !self.redo.is_empty()
     }
 
@@ -206,6 +212,10 @@ impl Session {
     /// the redo snapshot, replaces the body identity, refreshes equation editing and touches layout.
     pub fn undo(&mut self) -> bool {
         self.typing_open = false;
+        if self.external_history {
+            self.history_requests.push(false);
+            return self.external_can.0;
+        }
         // Undoing the automatic capitalisation's own step makes its word an exception; any
         // other Undo forgets the capital.
         let steps = self.history.len() as u64 + self.undo_evicted;
@@ -239,6 +249,10 @@ impl Session {
     /// refreshing equation editing and touching layout.
     pub fn redo(&mut self) -> bool {
         self.typing_open = false;
+        if self.external_history {
+            self.history_requests.push(true);
+            return self.external_can.1;
+        }
         let Some(u) = self.redo.pop().map(Arc::unwrap_or_clone) else { return false };
         let cur = Undo {
             label: u.label.clone(),
diff --git a/crates/engine/src/session/lifecycle.rs b/crates/engine/src/session/lifecycle.rs
index d7eefdbc..4b31d909 100644
--- a/crates/engine/src/session/lifecycle.rs
+++ b/crates/engine/src/session/lifecycle.rs
@@ -166,6 +166,9 @@ impl Session {
             findings: None,
             ribbon: crate::RibbonLayout::default(),
             editing_lang: None,
+            external_history: false,
+            history_requests: Vec::new(),
+            external_can: (false, false),
             read_aloud: Default::default(),
             windows: Default::default(),
             password,
diff --git a/crates/engine/src/session/snapshot.rs b/crates/engine/src/session/snapshot.rs
index fb584c13..ddd25b39 100644
--- a/crates/engine/src/session/snapshot.rs
+++ b/crates/engine/src/session/snapshot.rs
@@ -159,6 +159,10 @@ impl Session {
             ribbon: _,
             // A preference for new documents, like `prefs`: not part of this document.
             editing_lang: _,
+            // The host's history requests are not part of an edit.
+            external_history: _,
+            history_requests: _,
+            external_can: _,
             // Equation editing mode, like `view`: not part of the document or its history.
             math: _,
             math_latex: _,
diff --git a/crates/ui-egui/src/chrome/title_bar.rs b/crates/ui-egui/src/chrome/title_bar.rs
index 90cdfb33..63059da5 100644
--- a/crates/ui-egui/src/chrome/title_bar.rs
+++ b/crates/ui-egui/src/chrome/title_bar.rs
@@ -279,6 +279,15 @@ fn trailing(app: &mut WordApp, ui: &mut Ui, step: usize) -> Option<egui::Rect> {
             let _ = app.run("ui.discord", json!({}));
         }
     }
+    // People editing at the same time, in the colours of their carets, as in co-authoring.
+    let shown = if app.embed.hide_presence { 0 } else { 6 };
+    for c in app.embed.collaborators.iter().take(shown) {
+        let out = Avatar::new(c.name.clone())
+            .fill(c.color)
+            .tooltip(TooltipSpec::new(crate::i18n::fmt(tl!("{name} is editing"), &[("name", &c.name)])))
+            .show(ui);
+        rects.push(out.response.rect);
+    }
     let initials: String = app.session.user_initials().chars().take(2).collect();
     let out = Avatar::new(app.session.author.clone())
         .initials(initials)
