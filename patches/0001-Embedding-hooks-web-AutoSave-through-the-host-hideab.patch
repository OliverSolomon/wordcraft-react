From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ndamathia <47696354+OliverSolomon@users.noreply.github.com>
Date: Sat, 10 Oct 2026 19:14:20 +0300
Subject: [PATCH 1/6] Embedding hooks: web AutoSave through the host, hideable
 title bar and ribbon

- WordApp::set_autosave_target lets a host that keeps documents itself (a web
  page) turn on AutoSave; on the web each AutoSave goes through
  Services::download like File > Save.
- UiState::hide_title_bar and hide_ribbon hide the title bar and the whole
  ribbon (Word's Auto-hide Ribbon) for pages that embed WordCraft.
---
 crates/ui-egui/src/lib.rs | 40 ++++++++++++++++++++++++++++++++++-----
 1 file changed, 35 insertions(+), 5 deletions(-)

diff --git a/crates/ui-egui/src/lib.rs b/crates/ui-egui/src/lib.rs
index a4afbd9..f965331 100644
--- a/crates/ui-egui/src/lib.rs
+++ b/crates/ui-egui/src/lib.rs
@@ -196,6 +196,10 @@ pub struct UiState {
     pub window: Option<window_geometry::WindowGeometry>,
     /// Interface language: `auto` (follow the system) or a code from [`i18n::LANGUAGES`].
     pub language: String,
+    /// Embedded: hide the title bar (AutoSave, Quick Access Toolbar, title, search, account).
+    pub hide_title_bar: bool,
+    /// Embedded: hide the ribbon including its tab row (Word's "Auto-hide Ribbon").
+    pub hide_ribbon: bool,
     /// Editing preferences; the session owns them while running (see [`WordApp::prefs`]).
     pub editing: wordcraft_engine::Prefs,
     /// Read Aloud speed (1 = normal) and whether it skips citations and bibliographies.
@@ -280,6 +284,8 @@ impl Default for UiState {
             author: String::new(),
             window: None,
             language: i18n::AUTO.into(),
+            hide_title_bar: false,
+            hide_ribbon: false,
             editing: wordcraft_engine::Prefs::default(),
             read_aloud_rate: 1.0,
             read_aloud_skip_citations: true,
@@ -426,6 +432,8 @@ pub struct WordApp {
     /// there. A file that was merely opened isn't rewritten until the user saves it: saving drops
     /// whatever WordCraft can't represent (content controls, charts, macros…).
     autosave_path: Option<std::path::PathBuf>,
+    /// The host keeps documents itself (an embedding web page), so AutoSave may run on the web.
+    host_saves: bool,
     /// The file dialog the host is showing, and what its answer is for ([`file_dialogs`]).
     file_dialog: Option<file_dialogs::PendingDialog>,
     /// The built-in file browser, when it is open, and the folder it showed last (#576).
@@ -510,6 +518,7 @@ impl WordApp {
             read_aloud_at: None,
             read_aloud_error: None,
             autosave_path: None,
+            host_saves: false,
             change_picture_target: None,
             recipient_list_pending: false,
             font_generation: wordcraft_fonts::FontDb::global().generation(),
@@ -1429,11 +1438,21 @@ impl WordApp {
         self.session.path.is_some() && self.session.path == self.autosave_path
     }
 
+    /// Let AutoSave write to `path`, as if the user had saved there in this session (`None` stops
+    /// it). For hosts that keep documents themselves, such as a web page embedding WordCraft: on
+    /// the web AutoSave then hands each save to `Services::download`, which the host handles.
+    pub fn set_autosave_target(&mut self, path: Option<std::path::PathBuf>) {
+        self.host_saves = path.is_some();
+        self.session.path = path.clone();
+        self.autosave_path = path;
+    }
+
     /// Why AutoSave can't cover the document, or `None` when it can: it writes only a file the
     /// user saved to in this session, in a format that keeps everything, and never in the browser
-    /// (a page can't write to the user's files; saving there is a download, #176).
+    /// (a page can't write to the user's files; saving there is a download, #176) unless the page
+    /// keeps documents itself ([`Self::set_autosave_target`]).
     pub fn autosave_block(&self) -> Option<AutoSaveBlock> {
-        if self.services.download.is_some() {
+        if self.services.download.is_some() && !self.host_saves {
             return Some(AutoSaveBlock::Browser);
         }
         let Some(path) = &self.session.path else { return Some(AutoSaveBlock::Unsaved) };
@@ -1470,7 +1489,14 @@ impl WordApp {
     fn autosave_tick(&mut self, now: f64) {
         if self.autosaves() && self.session.dirty && now - self.last_autosave > 2500.0 && now - self.canvas.caret_visible_since > 1500.0 {
             self.last_autosave = now;
-            if let Err(e) = self.session.run("file.save", &json!({})) {
+            // On the web (a host that keeps documents) a save goes to the host through
+            // `Services::download`, as File › Save does there.
+            let r = if self.services.download.is_some() {
+                self.execute("file.save", json!({})).map(|_| ())
+            } else {
+                self.session.run("file.save", &json!({})).map(|_| ()).map_err(|e| e.to_string())
+            };
+            if let Err(e) = r {
                 log::warn!("AutoSave failed: {e}");
                 self.autosave_path = None;
                 self.status(i18n::fmt(tl!("AutoSave failed: {error}. Save the document to turn AutoSave back on."), &[("error", &e.to_string())]));
@@ -1517,8 +1543,12 @@ impl WordApp {
         if self.ui.backstage {
             backstage::show(self, ui);
         } else {
-            chrome::title_bar(self, ui);
-            ribbon::show(self, ui);
+            if !self.ui.hide_title_bar {
+                chrome::title_bar(self, ui);
+            }
+            if !self.ui.hide_ribbon {
+                ribbon::show(self, ui);
+            }
             chrome::status_bar(self, ui);
             panes::show(self, ui);
             egui::CentralPanel::default().frame(egui::Frame::NONE.fill(t.canvas)).show(ui, |ui| {
