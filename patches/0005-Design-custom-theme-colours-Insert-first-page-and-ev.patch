+/// Which of a section's headers (or footers) a `kind` param names.
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum HfKind {
+    Default,
+    First,
+    Even,
+}
+
+impl HfKind {
+    /// `None` when the params name no kind (the page's own slot is meant).
+    fn parse(v: &Value) -> Result<Option<HfKind>, CmdError> {
+        match p::str(v, "kind") {
+            None => Ok(None),
+            Some("default" | "primary" | "odd") => Ok(Some(HfKind::Default)),
+            Some("first") => Ok(Some(HfKind::First)),
+            Some("even") => Ok(Some(HfKind::Even)),
+            Some(x) => Err(CmdError::Params(format!("unknown `kind` `{x}` (default, first or even)"))),
+        }
+    }
+}
+
+/// The caret section's existing header (or footer) of `kind`, if any.
+fn kind_part(s: &Session, header: bool, kind: HfKind) -> Option<u32> {
+    let block = s.sel.focus.path.0.first().copied().unwrap_or(0) as usize;
+    let set = s.doc.sections().into_iter().find(|(end, _)| block <= *end).or_else(|| s.doc.sections().pop()).map(|(_, sp)| if header { sp.headers } else { sp.footers })?;
+    let id = match kind {
+        HfKind::Default => set.default,
+        HfKind::First => set.first,
+        HfKind::Even => set.even,
+    };
+    id.filter(|id| s.doc.parts.contains_key(id))
+}
+
+/// The caret section's header (or footer) of `kind`, made when there is none; a first-page one
+/// turns on Different First Page and an even-page one Different Odd & Even Pages.
+fn kind_part_made(s: &mut Session, header: bool, kind: HfKind) -> u32 {
+    if let Some(id) = kind_part(s, header, kind) {
+        return id;
+    }
+    let block = s.sel.focus.path.0.first().copied().unwrap_or(0) as usize;
+    let style = if header { "Header" } else { "Footer" };
+    let id = s.doc.add_part(if header { PartKind::Header } else { PartKind::Footer }, vec![para_block(Paragraph::new().styled(style))]);
+    let sect = s.doc.section_mut(block);
+    let set = if header { &mut sect.headers } else { &mut sect.footers };
+    match kind {
+        HfKind::Default => set.default = Some(id),
+        HfKind::First => {
+            set.first = Some(id);
+            sect.title_page = true;
+        }
+        HfKind::Even => {
+            set.even = Some(id);
+            s.doc.settings.even_odd_headers = true;
+        }
+    }
+    s.new_header_parts.push(id);
+    id
+}
