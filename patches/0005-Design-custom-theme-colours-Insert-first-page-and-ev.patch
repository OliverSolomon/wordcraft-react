+/// A named kind reaches the caret section's first-page or even-page header and footer, making
+/// them (and turning on their switch) when there are none, without touching the default one.
+#[test]
+fn header_and_footer_kinds_reach_their_own_slot() {
+    let mut s = Session::new(wordcraft_doc::Document::default());
+    s.run("insert.editHeader", &json!({"kind": "first"})).unwrap();
+    s.run("text.insert", &json!({"text": "Cover"})).unwrap();
+    s.run("insert.closeHeader", &json!({})).unwrap();
+    let sect = s.doc.section_mut(0).clone();
+    assert!(sect.title_page);
+    assert!(sect.headers.first.is_some() && sect.headers.default.is_none());
+    s.run("insert.editFooter", &json!({"kind": "even"})).unwrap();
+    s.run("insert.closeHeader", &json!({})).unwrap();
+    assert!(s.doc.settings.even_odd_headers);
+    // Going back to the first-page header finds the same part.
+    let first = s.doc.section_mut(0).headers.first;
+    let story = s.run("insert.editHeader", &json!({"kind": "first"})).unwrap()["story"].as_u64().map(|id| id as u32);
+    assert_eq!(story, first);
+    assert!(s.run("insert.editHeader", &json!({"kind": "sideways"})).is_err());
+}
