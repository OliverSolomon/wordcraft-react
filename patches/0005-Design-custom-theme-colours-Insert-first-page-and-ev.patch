+#[cfg(test)]
+mod custom_color_tests {
+    use serde_json::json;
+    use wordcraft_doc::props::Rgb;
+
+    use crate::Session;
+
+    /// Custom colours reach the document theme (and survive a save), and junk is refused.
+    #[test]
+    fn custom_theme_colors_reach_the_theme() {
+        let mut s = Session::new(wordcraft_doc::Document::default());
+        s.run("design.themeColors", &json!({"name": "From logo", "colors": {"accent1": "1A5C8A", "hlink": "0B6E99"}})).unwrap();
+        assert_eq!(s.doc.settings.theme_colors.get(4), Some(&Rgb(0x1A, 0x5C, 0x8A)));
+        assert_eq!(s.doc.settings.theme_colors.get(10), Some(&Rgb(0x0B, 0x6E, 0x99)));
+        assert_eq!(s.doc.settings.theme_name, "From logo");
+        let back = wordcraft_docx::read(&wordcraft_docx::write(&s.doc).unwrap()).unwrap();
+        assert_eq!(back.settings.theme_colors.get(4), Some(&Rgb(0x1A, 0x5C, 0x8A)));
+        assert!(s.run("design.themeColors", &json!({"colors": {"nope": "000000"}})).is_err());
+        assert!(s.run("design.themeColors", &json!({"colors": {"accent1": "not a colour"}})).is_err());
+    }
+}
