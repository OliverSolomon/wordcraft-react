From b2b32a116fb3e4d581f7d8960256c04e79190c2c Mon Sep 17 00:00:00 2001
From: ndamathia <47696354+OliverSolomon@users.noreply.github.com>
Date: Sat, 10 Oct 2026 19:58:21 +0300
Subject: [PATCH] web: a real clock for now_ms

now_ms returned 0 in the browser, so the caret never blinked, status messages
never timed out and AutoSave never fired. Read the browser clock instead.
---
 Cargo.lock                | 1 +
 crates/ui-egui/Cargo.toml | 4 ++++
 crates/ui-egui/src/lib.rs | 4 +++-
 3 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/Cargo.lock b/Cargo.lock
index ada579f..4d6782c 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -5070,6 +5070,7 @@ dependencies = [
  "serde_json",
  "sys-locale",
  "toml",
+ "web-time",
  "wordcraft-doc",
  "wordcraft-engine",
  "wordcraft-fonts",
diff --git a/crates/ui-egui/Cargo.toml b/crates/ui-egui/Cargo.toml
index d067515..157f852 100644
--- a/crates/ui-egui/Cargo.toml
+++ b/crates/ui-egui/Cargo.toml
@@ -30,3 +30,7 @@ image = { workspace = true }
 [build-dependencies]
 serde_json = { workspace = true }
 toml = "1"
+
+[target.'cfg(target_arch = "wasm32")'.dependencies]
+# The browser clock (std::time has none on wasm32-unknown-unknown).
+web-time = "1"
diff --git a/crates/ui-egui/src/lib.rs b/crates/ui-egui/src/lib.rs
index 3fad294..ab47c5a 100644
--- a/crates/ui-egui/src/lib.rs
+++ b/crates/ui-egui/src/lib.rs
@@ -904,7 +904,9 @@ pub fn now_ms() -> f64 {
     }
     #[cfg(target_arch = "wasm32")]
     {
-        0.0
+        // Caret blinking, status timeouts and AutoSave all need a real clock in the browser too.
+        use web_time::{SystemTime, UNIX_EPOCH};
+        SystemTime::now().duration_since(UNIX_EPOCH).map(|d| d.as_secs_f64() * 1000.0).unwrap_or(0.0)
     }
 }
 
-- 
2.43.0

