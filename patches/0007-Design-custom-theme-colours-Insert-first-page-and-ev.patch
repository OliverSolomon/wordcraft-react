+#[cfg(test)]
+mod tests {
+    use serde_json::json;
+    use wordcraft_doc::props::Rgb;
+
+    use crate::Session;
+
+    #[test]
+    fn custom_theme_colors_reach_the_theme_and_the_headings() {
+        let mut s = Session::new(wordcraft_doc::Document::default());
+        s.run("design.themeColors", &json!({"name": "From logo", "colors": {"accent1": "1A5C8A", "accent2": "E07A1F", "hlink": "0B6E99"}})).unwrap();
+        let t = &s.doc.settings.theme_colors;
+        assert_eq!(t.get(4), Some(&Rgb(0x1A, 0x5C, 0x8A)));
+        assert_eq!(t.get(5), Some(&Rgb(0xE0, 0x7A, 0x1F)));
+        assert_eq!(t.get(10), Some(&Rgb(0x0B, 0x6E, 0x99)));
+        assert_eq!(s.doc.settings.theme_name, "From logo");
+        let back = wordcraft_docx::read(&wordcraft_docx::write(&s.doc).unwrap()).unwrap();
+        assert_eq!(back.settings.theme_colors.get(4), Some(&Rgb(0x1A, 0x5C, 0x8A)));
+        assert!(s.run("design.themeColors", &json!({"colors": {"nope": "000000"}})).is_err());
+        assert!(s.run("design.themeColors", &json!({"colors": {"accent1": "not a colour"}})).is_err());
+    }
+}
