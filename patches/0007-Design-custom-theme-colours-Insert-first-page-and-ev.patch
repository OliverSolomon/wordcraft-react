+const SCHEME: [&str; 12] = ["dk1", "lt1", "dk2", "lt2", "accent1", "accent2", "accent3", "accent4", "accent5", "accent6", "hlink", "folHlink"];
+
+/// Design › Colors: a built-in colour set by name, or a custom one (`colors`) kept in the theme.
+fn theme_colors(s: &mut Session, v: &Value) -> CmdResult {
+    let Some(custom) = v.get("colors").and_then(Value::as_object) else {
+        let name = p::req_str(v, "name")?;
+        let t = THEMES.iter().find(|t| t.0.eq_ignore_ascii_case(name)).ok_or_else(|| CmdError::Params(format!("unknown colours `{name}`")))?;
+        set_accent(s, t.3[0]);
+        return sel_result(s);
+    };
+    let mut colors = s.doc.settings.theme_colors.clone();
+    for (i, d) in wordcraft_doc::THEME_COLORS.iter().enumerate() {
+        if colors.get(i).is_none() {
+            colors.push(*d);
+        }
+    }
+    let mut accent = None;
+    for (key, val) in custom {
+        let i = SCHEME.iter().position(|n| n.eq_ignore_ascii_case(key)).ok_or_else(|| CmdError::Params(format!("unknown theme colour `{key}`")))?;
+        let c = val.as_str().and_then(Rgb::parse).ok_or_else(|| CmdError::Params(format!("`{key}` is not a colour")))?;
+        if let Some(x) = colors.get_mut(i) {
+            *x = c;
+        }
+        if i == 4 {
+            accent = Some(c);
+        }
+    }
+    s.doc.settings.theme_colors = colors;
+    if let Some(name) = p::str(v, "name") {
+        s.doc.settings.theme_name = name.chars().take(64).collect();
+    }
+    if let Some(a) = accent {
+        set_accent(s, a);
+    }
+    sel_result(s)
+}
